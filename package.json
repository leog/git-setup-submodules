{
  "name": "git-setup-submodules",
  "version": "1.1.0",
  "description": "A CLI tool to automate Git submodule setup from a configuration file",
  "bin": {
    "git-setup-submodules": "./index.mjs"
  },
  "author": "Leo Giovanetti <hello@leog.me>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/leogme/git-setup-submodules.git"
  },
  "homepage": "https://github.com/leogme/git-setup-submodules#readme",
  "bugs": {
    "url": "https://github.com/leogme/git-setup-submodules/issues"
  },
  "keywords": [
    "git",
    "submodules",
    "cli",
    "automation",
    "monorepo",
    "git-submodules",
    "devtools"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.2",
    "commit-and-tag-version": "^12.5.0",
    "vitest": "2.1.2"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm test",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:first": "commit-and-tag-version --first-release",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "files": [
    "index.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
